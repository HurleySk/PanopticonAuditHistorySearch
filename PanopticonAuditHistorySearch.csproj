<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>7.3</LangVersion>

    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>

    <AssemblyName>PanopticonAuditHistorySearch</AssemblyName>
    <RootNamespace>PanopticonAuditHistorySearch</RootNamespace>
    <Title>Panopticon Audit History Search</Title>
    <Version>0.1.0.3</Version>
    <Authors>Samuel Hurley</Authors>
    <Company>Sam Hurley</Company>
    <Copyright>Copyright (c) Samuel Hurley 2026</Copyright>
    <Description>Search Dataverse audit history across multiple tables. Syncs audit metadata to a local SQLite cache for instant filtering by table, user, event, date and changed field, then fetches old/new values on demand.</Description>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoWarn>$(NoWarn);NU5048;NU5100;NU5128</NoWarn>

    <PackageProjectUrl>https://github.com/HurleySk/PanopticonAuditHistorySearch</PackageProjectUrl>
    <PackageIconUrl>https://raw.githubusercontent.com/HurleySk/PanopticonAuditHistorySearch/main/Resources/icon-128.png</PackageIconUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>XrmToolBox;Dynamics365;Dataverse;PowerPlatform;Audit</PackageTags>
    <PackageReleaseNotes>First alpha (0.x: unstable, cache format may change). Feature-complete against the v1 scope but not yet exercised against a live Dataverse org.</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/HurleySk/PanopticonAuditHistorySearch</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="XrmToolBoxPackage" Version="1.2025.7.71" />
    <PackageReference Include="MscrmTools.Xrm.Connection" Version="1.2025.7.63" />
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.0.2.59" />
    <PackageReference Include="Microsoft.CrmSdk.Deployment" Version="9.0.2.34" />
    <PackageReference Include="Microsoft.CrmSdk.XrmTooling.CoreAssembly" Version="9.1.1.65" />
    <PackageReference Include="Microsoft.CrmSdk.CoreTools" Version="9.0.3.1" PrivateAssets="All" />
    <PackageReference Include="System.Resources.Extensions" Version="4.7.1" />

    <!-- winsqlite3 binds to OS sqlite in System32: no native DLL. SQLitePCLRaw pinned to the exact
         version Microsoft.Data.Sqlite references; plugins get no binding redirects. -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="8.0.10" />
    <PackageReference Include="SQLitePCLRaw.bundle_winsqlite3" Version="2.1.6" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="Plugins\" />
    <None Include="$(OutputPath)\Microsoft.Data.Sqlite.dll" Pack="true" PackagePath="Plugins\Dependencies\" />
    <None Include="$(OutputPath)\SQLitePCLRaw.core.dll" Pack="true" PackagePath="Plugins\Dependencies\" />
    <None Include="$(OutputPath)\SQLitePCLRaw.batteries_v2.dll" Pack="true" PackagePath="Plugins\Dependencies\" />
    <None Include="$(OutputPath)\SQLitePCLRaw.provider.winsqlite3.dll" Pack="true" PackagePath="Plugins\Dependencies\" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.ComponentModel.Composition" />
  </ItemGroup>
</Project>
